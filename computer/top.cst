// top.cst: the pins of the mp32 computer on the Tang Nano 20K (top.v).
//
// The board's clock, buttons, serial port, LEDs and HDMI: board.cst of chapter 23 of
// 6502-gate-by-gate (without the keyboard's pin). The microSD card: ../sdcard/sdcard.cst.
// The SPI flash: MSPI_CLK 59, MSPI_CS 60, MSPI_DI 61, MSPI_DO 62 of the board's
// schematic (as in github.com/calint/tang-nano-20k--riscv--cache-sdram).
// The sound (the MAX98357A): Sipeed's TangNano-20K-example, audio/src/audio.cst.
// The keyboard's module: pin 42 as in chapter 21 of the book (the 5th hole of the row on
// the side of S2, from the USB-C end), and the hole after it, pin 41, for the way back.
// Both go only to the LCD connector, which stays empty (bank 4, 3.3 V).
// The SDRAM inside the GW2AR-18: its pins have no numbers on the package, only the
// names of the I/O cells they are wired to (as in the constraints of
// github.com/ArthurHeymans/tang_20k_spi_flash, which uses the same SDRAM with yosys and
// nextpnr-himbaechel). Check them against Sipeed's examples if the SDRAM does not answer.

// ---- the board
IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "btn1" 88;
IO_PORT "btn1" IO_TYPE=LVCMOS33;
IO_LOC  "btn2" 87;
IO_PORT "btn2" IO_TYPE=LVCMOS33;
IO_LOC  "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
# LVCMOS33, not the book's LVCMOS18: the LEDs share their I/O bank with the SDRAM,
# and a bank takes one I/O standard (as in ArthurHeymans/tang_20k_spi_flash)
IO_LOC  "led[0]" 15;
IO_PORT "led[0]" DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "led[1]" 16;
IO_PORT "led[1]" DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "led[2]" 17;
IO_PORT "led[2]" DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "led[3]" 18;
IO_PORT "led[3]" DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "led[4]" 19;
IO_PORT "led[4]" DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "led[5]" 20;
IO_PORT "led[5]" DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "tmds_clk_p" 33;
IO_PORT "tmds_clk_p" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC  "tmds_clk_n" 34;
IO_PORT "tmds_clk_n" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC  "tmds_d_p[0]" 35;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC  "tmds_d_n[0]" 36;
IO_PORT "tmds_d_n[0]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC  "tmds_d_p[1]" 37;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC  "tmds_d_n[1]" 38;
IO_PORT "tmds_d_n[1]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC  "tmds_d_p[2]" 39;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC  "tmds_d_n[2]" 40;
IO_PORT "tmds_d_n[2]" IO_TYPE=LVDS25 PULL_MODE=NONE;
// ---- the microSD card
IO_LOC  "sd_clk" 83;
IO_PORT "sd_clk" IO_TYPE=LVCMOS33;
IO_LOC  "sd_mosi" 82;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "sd_miso" 84;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "sd_cs_n" 81;
IO_PORT "sd_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// ---- the SPI flash (the board's MSPI pins: the flash that holds the bitstream).
// After configuration they are ours only with gowin_pack --mspi_as_gpio (Makefile).
// Its WP (57) and HOLD (63) are left alone: pulled up on the board.
IO_LOC  "flash_cs_n" 60;
IO_PORT "flash_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "flash_clk" 59;
IO_PORT "flash_clk" IO_TYPE=LVCMOS33;
IO_LOC  "flash_mosi" 61;
IO_PORT "flash_mosi" IO_TYPE=LVCMOS33;
IO_LOC  "flash_miso" 62;
IO_PORT "flash_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// ---- the sound: I2S to the MAX98357A, and its amplifier on
IO_LOC  "pa_en" 51;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "hp_din" 54;
IO_PORT "hp_din" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "hp_ws" 55;
IO_PORT "hp_ws" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "hp_bck" 56;
IO_PORT "hp_bck" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
// ---- the keyboard and the mouse: a CH9350L module, both ways (../keyboard/keyboard.v)
IO_LOC  "kbd_rx" 42;
IO_PORT "kbd_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "kbd_tx" 41;
IO_PORT "kbd_tx" IO_TYPE=LVCMOS33;
// ---- the SDRAM
IO_LOC  "O_sdram_clk" IOR11B;
IO_PORT "O_sdram_clk" IO_TYPE=LVCMOS33;
IO_LOC  "O_sdram_cke" IOL13A;
IO_PORT "O_sdram_cke" IO_TYPE=LVCMOS33;
IO_LOC  "O_sdram_cs_n" IOL14B;
IO_PORT "O_sdram_cs_n" IO_TYPE=LVCMOS33;
